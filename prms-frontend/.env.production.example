# ─────────────────────────────────────────────────────────────────────────────
# PRMS Frontend — Vercel Environment Variables
# Add these in: Vercel Dashboard → Project → Settings → Environment Variables
# Set environment to "Production" (and optionally "Preview").
# ─────────────────────────────────────────────────────────────────────────────

# Backend Railway URL  (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=https://YOUR_BACKEND_RAILWAY_DOMAIN/api/v1

# Keycloak Railway URL  (no trailing slash)
NEXT_PUBLIC_KEYCLOAK_URL=https://YOUR_KEYCLOAK_RAILWAY_DOMAIN

# Keycloak realm and client — these match prms-realm.json; no need to change
NEXT_PUBLIC_KEYCLOAK_REALM=prms
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=prms-frontend
