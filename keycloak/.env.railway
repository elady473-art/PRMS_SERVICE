# ─────────────────────────────────────────────────────────────────────────────
# Keycloak — Railway Environment Variables
# Copy these into Railway → Keycloak service → Variables tab.
# ─────────────────────────────────────────────────────────────────────────────

# ── Admin credentials ─────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Keycloak's own PostgreSQL database ───────────────────────────────────────
# Option A: use a second Supabase project or a separate Supabase schema
# Option B: add a second Railway Postgres service (cheaper on free tier)
# Either way, fill in the connection details below.
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://YOUR_KC_POSTGRES_HOST:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=YOUR_KC_DB_PASSWORD

# ── Hostname / proxy settings ─────────────────────────────────────────────────
# Railway exposes Keycloak on a generated HTTPS domain.
# Set KC_HOSTNAME to that domain once Railway assigns it (no https://, just the host).
KC_HOSTNAME=YOUR_KEYCLOAK_RAILWAY_DOMAIN
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_ENABLED=true
KC_PROXY=edge          # tells Keycloak it sits behind an SSL-terminating proxy (Railway)

# ── Port — Railway injects PORT automatically ─────────────────────────────────
# Keycloak's internal HTTP port must match what Railway expects.
KC_HTTP_PORT=8080

# ── Realm import ─────────────────────────────────────────────────────────────
# The realm JSON is baked into the image via a volume mount.
# On Railway, mount the file or paste the realm JSON as an env var is not practical.
# Instead, after first deploy, import via Keycloak Admin UI or CLI (see guide).
