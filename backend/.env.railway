# ─────────────────────────────────────────────────────────────────────────────
# PRMS Backend — Railway Environment Variables
# Copy these into Railway → Service → Variables tab.
# Replace every YOUR_* placeholder with real values from each platform.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase PostgreSQL ───────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project → Settings → Database → Connection string
# Use the "Transaction pooler" URI (port 6543) for serverless-style deploys.
POSTGRES_HOST=YOUR_SUPABASE_HOST.supabase.com
POSTGRES_PORT=6543
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
POSTGRES_SSL_MODE=require

# ── Keycloak (Railway service) ────────────────────────────────────────────────
# Set this after Keycloak is deployed; format: https://<kc-railway-domain>/realms/prms
JWT_ISSUER_URI=https://YOUR_KEYCLOAK_RAILWAY_DOMAIN/realms/prms

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://YOUR_VERCEL_DOMAIN

# ── Railway injects PORT automatically — do not set it manually ──────────────
# PORT=8080   # ← do NOT add this; Railway manages it

# ── JPA / Flyway ─────────────────────────────────────────────────────────────
JPA_DDL_AUTO=update
FLYWAY_ENABLED=false

# ── Redis (optional — Railway add-on or Upstash) ─────────────────────────────
# If you add a Redis service on Railway, use its REDIS_URL env var instead.
# Leave blank to use the in-memory fallback (caching will still work locally).
REDIS_HOST=YOUR_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# ── RabbitMQ (optional — CloudAMQP free tier or Railway add-on) ──────────────
RABBITMQ_HOST=YOUR_RABBITMQ_HOST
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=YOUR_RABBITMQ_USER
RABBITMQ_PASSWORD=YOUR_RABBITMQ_PASSWORD

# ── Integration service URLs (set to your own or leave as localhost) ──────────
FMS_BASE_URL=http://localhost:8082
HRM_BASE_URL=http://localhost:8083
INVENTORY_BASE_URL=http://localhost:8081

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
